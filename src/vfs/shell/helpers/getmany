LC_TIME=C
export LC_TIME
# Send the files named in the arguments ("$@") one after the other, each as the get script sends
# it: its size, "### 100", its data, "### 200"; or "### 500" if it cannot be read. A file that
# changes while it is sent is sent with the size it had when opened, to keep the stream in step;
# if it has got shorter, the missing end is sent as zeros and "### 500" instead of "### 200".
perl -e '
use strict;
binmode STDOUT;
my $buf;
foreach my $name (@ARGV) {
    my $fh;
    if (!open ($fh, "<", $name)) {
        print "### 500\n";
        next;
    }
    if (! -f $fh) {
        close ($fh);
        print "### 500\n";
        next;
    }
    binmode $fh;
    my $left = (stat ($fh))[7];
    print "$left\n### 100\n";
    while ($left > 0) {
        my $n = read ($fh, $buf, $left < 1048576 ? $left : 1048576);
        last if (!$n);
        print $buf;
        $left -= $n;
    }
    close ($fh);
    if ($left > 0) {
        # the file has got shorter: keep the stream in step, and report the copy as broken
        print "\0" x $left;
        print "### 500\n";
    } else {
        print "### 200\n";
    }
}
' "$@"
